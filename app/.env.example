# Deployed contract addresses on QoreChain testnet (qorechain-diana, 9800).
# Fill these in after running `npm run deploy` from the project root
# (the deploy script also writes deployments/qorechain-diana-9800.json).
# Until set, the app shows a setup notice and disables writes.
VITE_CERTIFICATE_ADDRESS=
VITE_VERIFIER_ADDRESS=

# EVM JSON-RPC endpoint (defaults to the SDK's testnet endpoint).
# VITE_RPC_URL=https://evm-testnet.qore.host
